{
  // Cloudflare Worker: serves the Vite build in ./dist and an anonymous play counter at /api/*
  "name": "outsmart-the-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "COUNTER", "class_name": "PlayCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlayCounter"] }]
}
